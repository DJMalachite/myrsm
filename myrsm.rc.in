#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

IDI_ICON1 ICON DISCARDABLE "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_JOB_SPLIT@
PRODUCTVERSION @VERSION_SPLIT@

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   /*    LANG_ENGLISH/SUBLANG_ENGLISH_US, Unicode CP */
        BEGIN
            VALUE "Comment",          "@COMMENT@"
            VALUE "InternalName",     "internalname"
            VALUE "OriginalFilename", "myrsm.exe"
            VALUE "FileDescription",  "Data exporter: @COMMENT@"
            VALUE "CompanyName",      "DJMalachite"
            VALUE "FileVersion",      "@VERSION_JOB@"
            VALUE "ProductName",      "MyRsm"
            VALUE "ProductVersion",   "@VERSION@"
            VALUE "LegalCopyright",   "Private use only"
        END
    END

        BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
