#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

IDI_ICON1 ICON DISCARDABLE "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,1
PRODUCTVERSION 0,0,1

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   /*    LANG_ENGLISH/SUBLANG_ENGLISH_US, Unicode CP */
        BEGIN
            VALUE "Comment",          "localbuild"
            VALUE "InternalName",     "internalname"
            VALUE "OriginalFilename", "myrsm.exe"
            VALUE "FileDescription",  "Data exporter: localbuild"
            VALUE "CompanyName",      "qdel"
            VALUE "FileVersion",      "1"
            VALUE "ProductName",      "MyRsm"
            VALUE "ProductVersion",   "1"
            VALUE "LegalCopyright",   "Private use only"
        END
    END

        BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
